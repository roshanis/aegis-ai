{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "passThroughEnv": ["AEGIS_TEST_DATABASE_URL", "AEGIS_REQUIRE_POSTGRES"]
    },
    "typecheck": {}
  }
}
